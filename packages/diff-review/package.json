{
  "name": "@onkarbhardwaj/pi-diff-review",
  "version": "0.1.0",
  "description": "Interactive local diff review for Pi",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkarbhardwaj/pi-extensions.git",
    "directory": "packages/diff-review"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "config.example.json"
  ],
  "pi": {
