{
  "name": "@onkarbhardwaj/pi-chart",
  "version": "0.1.0",
  "description": "Draw charts with matplotlib's API in pure JavaScript (mpljs), and show the agent the image",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "chart",
    "matplotlib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onkarbhardwaj/pi-extensions.git",
    "directory": "packages/chart"
  },
  "files": [
    "src",
    "vendor",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --test tests/*.test.ts"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  }
}
